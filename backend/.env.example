# FraudShield AI Environment Configuration

PROJECT_NAME="FraudShield AI Backend"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (SQLite by default for zero-config development)
# For PostgreSQL: postgresql://user:password@localhost:5432/fraudshield
DATABASE_URL="sqlite:///./fraudshield.db"

# Allowed CORS Origins (comma-separated or JSON list)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","*"]

# Risk Engine Model Weights
XGB_WEIGHT=0.60
IFOREST_WEIGHT=0.40

# Risk Thresholds
LOW_THRESHOLD=39.0
MEDIUM_THRESHOLD=69.0
