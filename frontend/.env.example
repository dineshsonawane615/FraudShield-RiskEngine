# FraudShield AI — Frontend Environment Configuration
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit .env to version control.

# Backend API URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Gemini API key (if used by the frontend — keep server-side if possible)
# Note: NEXT_PUBLIC_ prefix exposes variables to the browser bundle.
# For sensitive keys, handle on the backend only — do NOT use NEXT_PUBLIC_.
# GEMINI_API_KEY=your-key-here
